<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane style="-fx-background-color: #f8fafc;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.client.controllers.admin.AdminDashboardController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-background-color: white; -fx-padding: 16 24; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;">
            <children>
                <VBox spacing="2">
                    <children>
                        <Label text="Quản trị hệ thống" textFill="#0f172a">
                            <font>
                                <Font name="System Bold" size="22" />
                            </font>
                        </Label>
                        <Label text="Theo dõi người dùng, sản phẩm và phiên đấu giá" textFill="#64748b" />
                    </children>
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <Label fx:id="adminNameLabel" text="Xin chào, admin" textFill="#334155">
                    <font>
                        <Font name="System Bold" size="13" />
                    </font>
                </Label>

                <Button text="Đăng xuất"
                        onAction="#onLogoutClicked"
                        style="-fx-background-color: #fee2e2; -fx-text-fill: #b91c1c; -fx-padding: 10 18; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" />
            </children>
        </HBox>
    </top>

    <left>
        <VBox spacing="8" prefWidth="240"
              style="-fx-background-color: white; -fx-padding: 20; -fx-border-color: #e2e8f0; -fx-border-width: 0 1 0 0;">
            <children>
                <Label text="MENU ADMIN" textFill="#94a3b8">
                    <font>
                        <Font name="System Bold" size="11" />
                    </font>
                </Label>

                <Button fx:id="overviewButton" text="📊  Tổng quan"
                        maxWidth="Infinity" onAction="#loadOverview" />
                <Button fx:id="usersButton" text="👥  Quản lý người dùng"
                        maxWidth="Infinity" onAction="#loadUsers" />
                <Button fx:id="itemsButton" text="📦  Quản lý sản phẩm"
                        maxWidth="Infinity" onAction="#loadItems" />
                <Button fx:id="auctionsButton" text="🔨  Phiên đấu giá"
                        maxWidth="Infinity" onAction="#loadAuctions" />
                <Button fx:id="statsButton" text="📈  Thống kê"
                        maxWidth="Infinity" onAction="#loadStats" />

                <Region VBox.vgrow="ALWAYS" />

                <VBox spacing="8" style="-fx-background-color: #f8fafc; -fx-background-radius: 14; -fx-padding: 14;">
                    <children>
                        <Label text="Gợi ý" textFill="#334155">
                            <font>
                                <Font name="System Bold" size="12" />
                            </font>
                        </Label>
                        <Label text="Admin có thể khóa người dùng, hủy phiên đang chạy và theo dõi toàn bộ dữ liệu hệ thống." wrapText="true" textFill="#64748b" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="16" style="-fx-padding: 22;">
            <children>
                <Label fx:id="pageTitleLabel" text="Tổng quan hệ thống" textFill="#0f172a">
                    <font>
                        <Font name="System Bold" size="24" />
                    </font>
                </Label>
                <StackPane fx:id="contentPane" VBox.vgrow="ALWAYS" />
            </children>
        </VBox>
    </center>
</BorderPane>
