<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="14" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.client.controllers.admin.AdminUsersController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <children>
                <TextField fx:id="searchField" promptText="Tìm theo ID, username hoặc role..."
                           onKeyReleased="#onSearchChanged"
                           prefWidth="360"
                           style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-padding: 10;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="Làm mới" onAction="#onRefreshClicked"
                        style="-fx-background-color: #e2e8f0; -fx-text-fill: #334155; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 9 18; -fx-cursor: hand;" />
                <Button fx:id="banButton" text="Khóa tài khoản" onAction="#onBanClicked"
                        style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 9 18; -fx-cursor: hand;" />
                <Button fx:id="unbanButton" text="Mở khóa" onAction="#onUnbanClicked"
                        style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 9 18; -fx-cursor: hand;" />
            </children>
        </HBox>

        <VBox spacing="10" VBox.vgrow="ALWAYS"
              style="-fx-background-color: white; -fx-background-radius: 18; -fx-border-color: #e2e8f0; -fx-border-radius: 18; -fx-padding: 16; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.08), 14, 0, 0, 4);">
            <children>
                <Label text="Danh sách tài khoản" textFill="#0f172a">
                    <font><Font name="System Bold" size="16" /></font>
                </Label>
                <TableView fx:id="usersTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="idColumn" text="ID" prefWidth="70" />
                        <TableColumn fx:id="usernameColumn" text="Username" prefWidth="180" />
                        <TableColumn fx:id="roleColumn" text="Vai trò" prefWidth="150" />
                        <TableColumn fx:id="balanceColumn" text="Số dư" prefWidth="180" />
                        <TableColumn fx:id="statusColumn" text="Trạng thái" prefWidth="130" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </children>
</VBox>
