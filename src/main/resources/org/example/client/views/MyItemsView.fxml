<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.client.controllers.MyItemsController"
      spacing="16"
      style="-fx-padding: 24; -fx-background-color: #f8fafc;"
      VBox.vgrow="ALWAYS">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="12">
            <children>
                <Label text="Sản phẩm của tôi" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />
                <Label fx:id="myItemsSummaryLabel" text="Tổng: 0 sản phẩm"
                       style="-fx-background-color: #dbeafe; -fx-text-fill: #2563eb; -fx-padding: 5 10; -fx-background-radius: 20; -fx-font-weight: bold; -fx-font-size: 11;" />
            </children>
        </HBox>

        <FlowPane alignment="CENTER_LEFT" hgap="14" vgap="12"
                  style="-fx-background-color: white; -fx-padding: 16; -fx-border-color: #e2e8f0; -fx-border-radius: 12; -fx-background-radius: 12; -fx-border-width: 1;">
            <children>
                <TextField fx:id="myItemsSearchTextField" prefHeight="40" prefWidth="420"
                           promptText="Tìm kiếm sản phẩm của bạn..."
                           style="-fx-background-radius: 9; -fx-border-color: #e2e8f0; -fx-border-radius: 9; -fx-background-color: white; -fx-padding: 0 14; -fx-font-size: 12;" />
                <ComboBox fx:id="myItemsStatusComboBox" prefHeight="40" prefWidth="180"
                          style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 9; -fx-background-radius: 9; -fx-padding: 0 10;" />
                <ComboBox fx:id="myItemsSortComboBox" prefHeight="40" prefWidth="180"
                          style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 9; -fx-background-radius: 9; -fx-padding: 0 10;" />
                <Button text="🔄 Làm mới" onAction="#onMyItemsRefreshClicked" prefHeight="40" prefWidth="126"
                        style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-padding: 8 18; -fx-font-size: 12; -fx-background-radius: 9; -fx-cursor: hand; -fx-font-weight: bold;" />
            </children>
        </FlowPane>

        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: #f8fafc; -fx-padding: 0;">
            <content>
                <FlowPane fx:id="myItemsFlowPane" alignment="TOP_LEFT" hgap="24" vgap="24" style="-fx-background-color: #f8fafc;">
                    <padding>
                        <Insets top="0" right="0" bottom="24" left="0" />
                    </padding>
                </FlowPane>
            </content>
        </ScrollPane>
    </children>
</VBox>
