<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="sidebarRoot" prefWidth="280.0" spacing="0" style="-fx-background-color: #1e293b; -fx-padding: 0;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.client.controllers.home.HomeSidebarController">
   <children>
      <VBox alignment="CENTER" prefHeight="100.0" spacing="10.0" style="-fx-background-color: #0f172a; -fx-padding: 20;">
         <children>
            <Label text="ĐẤU GIÁ" textFill="#38bdf8">
               <font><Font name="System Bold" size="24.0" /></font>
            </Label>
            <Label text="Sàn giao dịch trực tuyến" textFill="#94a3b8" wrapText="true">
               <font><Font size="12.0" /></font>
            </Label>
         </children>
      </VBox>

      <Separator style="-fx-padding: 0; -fx-border-color: #334155;" />

      <VBox spacing="8.0" style="-fx-padding: 20;">
         <children>
            <Label text="Vai trò hiện tại:" textFill="#94a3b8">
               <font><Font size="11.0" /></font>
            </Label>
            <HBox spacing="10.0">
               <children>
                  <Label fx:id="currentRoleLabel" text="Người đấu giá" textFill="#38bdf8">
                     <font><Font name="System Bold" size="14.0" /></font>
                  </Label>
               </children>
            </HBox>
         </children>
      </VBox>


      <Separator style="-fx-padding: 15 0; -fx-border-color: #334155;" />

      <VBox spacing="5.0" style="-fx-padding: 0 15;">
         <children>
            <Button fx:id="homeMenuItem" mnemonicParsing="false" onAction="#switchToHomeView" prefHeight="45.0" prefWidth="250.0" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-padding: 12 20; -fx-font-size: 13; -fx-background-radius: 8; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;" text="Trang chủ" />

            <Label fx:id="bidderMenuLabel" text="CHO NGƯỜI ĐẤU GIÁ" textFill="#475569" VBox.vgrow="NEVER">
               <font><Font name="System Bold" size="10.0" /></font>
               <VBox.margin><Insets bottom="8.0" top="15.0" /></VBox.margin>
            </Label>

            <Button fx:id="bidHistoryMenuItem" mnemonicParsing="false" onAction="#switchToBidHistoryView" prefHeight="40.0" prefWidth="250.0" style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-padding: 10 20; -fx-font-size: 12; -fx-background-radius: 6; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;" text="Lịch sử đấu giá" />

            <Label fx:id="sellerMenuLabel" text="CHO NGƯỜI BÁN" textFill="#475569" VBox.vgrow="NEVER">
               <font><Font name="System Bold" size="10.0" /></font>
               <VBox.margin><Insets bottom="8.0" top="15.0" /></VBox.margin>
            </Label>

            <Button fx:id="addItemMenuItem" mnemonicParsing="false" onAction="#switchToAddItemView" prefHeight="40.0" prefWidth="250.0" style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-padding: 10 20; -fx-font-size: 12; -fx-background-radius: 6; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;" text="Đăng sản phẩm mới" />

            <Button fx:id="myItemsMenuItem" mnemonicParsing="false" onAction="#switchToMyItemsView" prefHeight="40.0" prefWidth="250.0" style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-padding: 10 20; -fx-font-size: 12; -fx-background-radius: 6; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;" text="Sản phẩm của tôi" />

            <Button fx:id="salesHistoryMenuItem" mnemonicParsing="false" onAction="#switchToSalesHistoryView" prefHeight="40.0" prefWidth="250.0" style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-padding: 10 20; -fx-font-size: 12; -fx-background-radius: 6; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;" text="Lịch sử bán hàng" />
         </children>
      </VBox>

      <VBox VBox.vgrow="ALWAYS" />

      <VBox spacing="10.0" style="-fx-padding: 20;">
         <children>
            <Separator style="-fx-border-color: #334155;" />
            <Button fx:id="roleSelectionBackButton" mnemonicParsing="false" onAction="#switchToRoleSelectionView" prefWidth="240.0" style="-fx-background-color: #334155; -fx-text-fill: #e2e8f0; -fx-padding: 10 15; -fx-font-size: 12; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="← Quay lại chọn vai trò" />
            <Button fx:id="logoutButton" mnemonicParsing="false" onAction="#onLogoutClicked" prefWidth="240.0" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-padding: 10 15; -fx-font-size: 12; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Đăng xuất" />
         </children>
      </VBox>
   </children>
</VBox>
