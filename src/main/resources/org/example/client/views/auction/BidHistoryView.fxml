<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import java.net.URL?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://fxml.com/fxml/1"
      fx:controller="org.example.client.controllers.auction.BidHistoryController"
      spacing="12"
      style="-fx-padding: 20; -fx-background-color: #f8fafc;"
      stylesheets="@../../../../styles/chart-style.css"
      VBox.vgrow="ALWAYS">

    <children>
        <Label text="Lịch sử đấu giá của bạn"
               style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />

        <HBox alignment="CENTER_LEFT"
              spacing="12"
              style="-fx-background-color: white;
                     -fx-padding: 14;
                     -fx-border-color: #e2e8f0;
                     -fx-border-radius: 10;
                     -fx-background-radius: 10;
                     -fx-border-width: 1;">

            <TextField fx:id="bidHistorySearchTextField"
                       prefHeight="38"
                       prefWidth="250"
                       promptText="Tìm kiếm sản phẩm..."
                       style="-fx-background-radius: 8;
                              -fx-border-color: #e2e8f0;
                              -fx-border-radius: 8;
                              -fx-background-color: white;
                              -fx-padding: 0 14;
                              -fx-font-size: 12;" />

            <ComboBox fx:id="bidHistoryStatusComboBox"
                      prefHeight="38"
                      prefWidth="140"
                      promptText="Lọc trạng thái..."
                      style="-fx-background-color: white;
                             -fx-border-color: #e2e8f0;
                             -fx-border-radius: 8;
                             -fx-background-radius: 8;
                             -fx-padding: 0 10;" />

            <ComboBox fx:id="bidHistorySortComboBox"
                      prefHeight="38"
                      prefWidth="140"
                      promptText="Sắp xếp..."
                      style="-fx-background-color: white;
                             -fx-border-color: #e2e8f0;
                             -fx-border-radius: 8;
                             -fx-background-radius: 8;
                             -fx-padding: 0 10;" />

            <HBox HBox.hgrow="ALWAYS" />

            <Button fx:id="bidHistoryRefreshButton"
                    mnemonicParsing="false"
                    onAction="#onBidHistoryRefreshClicked"
                    text="Làm mới"
                    prefHeight="38"
                    style="-fx-background-color: #3b82f6;
                           -fx-text-fill: white;
                           -fx-padding: 8 18;
                           -fx-font-size: 12;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;
                           -fx-font-weight: bold;" />
        </HBox>

        <HBox spacing="14" VBox.vgrow="ALWAYS">
            <children>

                <TableView fx:id="bidHistoryTable"
                           HBox.hgrow="ALWAYS"
                           prefWidth="600"
                           style="-fx-background-color: white;
                                  -fx-border-color: #e2e8f0;
                                  -fx-border-radius: 10;
                                  -fx-background-radius: 10;
                                  -fx-font-family: 'System';
                                  -fx-font-size: 12;">
                    <columns>
                        <TableColumn fx:id="colItemName" text="Tên sản phẩm" prefWidth="160" />
                        <TableColumn fx:id="colItemType" text="Loại" prefWidth="80" />
                        <TableColumn fx:id="colBidAmount" text="Giá đặt" prefWidth="100" />
                        <TableColumn fx:id="colBidTime" text="Thời gian" prefWidth="120" />
                        <TableColumn fx:id="colAuctionStatus" text="Trạng thái" prefWidth="90" />
                        <TableColumn fx:id="colResult" text="Kết quả" prefWidth="90" />
                    </columns>
                </TableView>

                <VBox HBox.hgrow="ALWAYS"
                      prefWidth="450"
                      style="-fx-background-color: white;
                             -fx-border-color: #e2e8f0;
                             -fx-border-radius: 10;
                             -fx-background-radius: 10;
                             -fx-padding: 10;">
                    <children>
                        <Label text="Xu hướng giá (Sản phẩm đang chọn)"
                               style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #475569; -fx-padding: 0 0 0 10;" />
                        <LineChart fx:id="bidLineChart"
                                   legendSide="BOTTOM"
                                   VBox.vgrow="ALWAYS">
                            <xAxis>
                                <CategoryAxis fx:id="chartXAxis" label="Thời gian" side="BOTTOM" />
                            </xAxis>
                            <yAxis>
                                <NumberAxis fx:id="chartYAxis" label="Mức giá (VND)" side="LEFT" forceZeroInRange="false" />
                            </yAxis>
                        </LineChart>
                    </children>
                </VBox>

            </children>
        </HBox>
    </children>
</VBox>